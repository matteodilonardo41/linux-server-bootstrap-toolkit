#!/bin/bash
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    exec sudo "$0" "$@"
fi

HOST="$(hostname -s)"
LOG_DIR="/var/log/server-update"
STAMP="$(date +%Y%m%d_%H%M%S)"
LOG_FILE="$LOG_DIR/aggiorna-$STAMP.log"

mkdir -p "$LOG_DIR"
chmod 750 "$LOG_DIR"

exec > >(tee -a "$LOG_FILE") 2>&1

echo "========================================"
echo " Aggiornamento sistema: $HOST"
echo " Avvio: $(date)"
echo " Log: $LOG_FILE"
echo "========================================"

echo
echo "[1/4] Aggiornamento indici APT"
apt update

echo
echo "[2/4] Pacchetti aggiornabili"
UPGRADABLE="$(apt list --upgradable 2>/dev/null | sed '1d' || true)"
if [ -n "$UPGRADABLE" ]; then
    printf '%s\n' "$UPGRADABLE"
else
    echo "Nessun pacchetto aggiornabile."
fi

echo
read -r -p "Procedere con apt upgrade? [s/N] " ANSWER
case "$ANSWER" in
    s|S|si|SI|sì|SÌ)
        ;;
    *)
        echo "Aggiornamento annullato dall'utente."
        exit 0
        ;;
esac

echo
echo "[3/4] Installazione aggiornamenti"
apt upgrade

echo
echo "[4/4] Verifica finale"
if [ -f /run/reboot-required ] || [ -f /var/run/reboot-required ]; then
    echo "ATTENZIONE: riavvio richiesto."
    [ -f /run/reboot-required.pkgs ] && {
        echo "Pacchetti che richiedono il riavvio:"
        cat /run/reboot-required.pkgs
    }
else
    echo "Aggiornamento completato: riavvio non richiesto."
fi

echo
echo "Pacchetti ancora aggiornabili:"
apt list --upgradable 2>/dev/null | sed '1d' || true

echo
echo "Fine: $(date)"
